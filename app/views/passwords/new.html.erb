<% content_for :title, "Reset Password | Shop Floor" %>

<section class="auth-shell">
  <div class="auth-shell__signal auth-shell__signal--blue" aria-hidden="true">
    <span>RESET</span>
    <strong>02</strong>
  </div>

  <div class="auth-panel">
    <header class="auth-panel__heading">
      <p class="eyebrow">Account recovery</p>
      <h1>Forgot Your Password?</h1>
      <p>Enter your operator email and we will transmit reset instructions.</p>
    </header>

    <%= form_with url: passwords_path, class: "record-form record-form--auth" do |form| %>
      <div class="form-field form-field--wide">
        <%= form.label :email_address, "Email address" %>
        <%= form.email_field :email_address,
          autocomplete: "username",
          autofocus: true,
          placeholder: "operator@facility.com",
          required: true,
          value: params[:email_address] %>
      </div>

      <div class="form-actions form-actions--stacked">
        <%= form.submit "Email Reset Instructions", class: "button button--primary button--full" %>
        <%= link_to "Back to Sign In", new_session_path, class: "text-link text-link--back" %>
      </div>
    <% end %>
  </div>
</section>
