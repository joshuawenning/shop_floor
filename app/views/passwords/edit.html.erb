<% content_for :title, "Update Password | Shop Floor" %>

<section class="auth-shell">
  <div class="auth-shell__signal auth-shell__signal--blue" aria-hidden="true">
    <span>RESET</span>
    <strong>03</strong>
  </div>

  <div class="auth-panel">
    <header class="auth-panel__heading">
      <p class="eyebrow">Secure credential update</p>
      <h1>Update your password</h1>
      <p>Set and confirm the new password for your operator account.</p>
    </header>

    <%= form_with url: password_path(params[:token]), class: "record-form record-form--auth", method: :put do |form| %>
      <div class="form-field form-field--wide">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password,
          autocomplete: "new-password",
          maxlength: 72,
          placeholder: "Enter new password",
          required: true %>
      </div>

      <div class="form-field form-field--wide">
        <%= form.label :password_confirmation, "Confirm password" %>
        <%= form.password_field :password_confirmation,
          autocomplete: "new-password",
          maxlength: 72,
          placeholder: "Repeat new password",
          required: true %>
      </div>

      <div class="form-actions form-actions--stacked">
        <%= form.submit "Save", class: "button button--primary button--full" %>
      </div>
    <% end %>
  </div>
</section>
