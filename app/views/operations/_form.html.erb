<%= form_with model: [work_order, operation] do |form| %>
  <% if operation.errors.any? %>
    <div>
      <h2>
        <%= pluralize(operation.errors.count, "error") %>
        prevented this operation from being saved:
      </h2>

      <ul>
        <% operation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :position %>
    <%= form.number_field :position, min: 1 %>
  </div>

  <div>
    <%= form.label :status %>
    <%= form.select(
      :status,
      Operation.statuses.keys.map { |status| [status.humanize, status] }
    ) %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
