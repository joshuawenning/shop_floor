<%= form_with model: work_order, class: "record-form" do |form| %>
  <% if work_order.errors.any? %>
    <div class="form-errors" role="alert">
      <span class="form-errors__code">Input error</span>
      <h2><%= pluralize(work_order.errors.count, "error") %> prevented this work order from being saved</h2>
      <ul>
        <% work_order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="form-field">
      <%= form.label :number %>
      <%= form.text_field :number, required: true %>
      <small>Unique production identifier</small>
    </div>

    <div class="form-field">
      <%= form.label :part_id, "Part" %>
      <%= form.collection_select(
        :part_id,
        Part.order(:number),
        :id,
        :number,
        { prompt: "Select a part" },
        { required: true }
      ) %>
      <small>Controlled component to manufacture</small>
    </div>

    <div class="form-field">
      <%= form.label :quantity %>
      <%= form.number_field :quantity, min: 1, required: true %>
      <small>Planned unit count</small>
    </div>

    <div class="form-field">
      <%= form.label :due_on %>
      <%= form.date_field :due_on, required: true %>
      <small>Required completion date</small>
    </div>

    <div class="form-field form-field--wide">
      <%= form.label :status %>
      <%= form.select(
        :status,
        WorkOrder.statuses.keys.map { |status| [status.humanize, status] }
      ) %>
      <small>Completion requires every operation to be complete</small>
    </div>

    <div class="form-field form-field--wide">
      <%= form.label :notes %>
      <%= form.text_area :notes, rows: 5 %>
      <small>Manufacturing constraints, disposition, or context</small>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button button--primary" %>
    <%= link_to "Cancel", work_order.persisted? ? work_order : work_orders_path, class: "text-link" %>
  </div>
<% end %>
