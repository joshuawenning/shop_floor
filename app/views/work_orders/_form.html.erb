<%= form_with model: work_order do |form| %>
  <% if work_order.errors.any? %>
    <div>
      <h2>
        <%= pluralize(work_order.errors.count, "error") %>
        prevented this work order from being saved:
      </h2>

      <ul>
        <% work_order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :number %>
    <%= form.text_field :number %>
  </div>

  <div>
    <%= form.label :part_id, "Part" %>
    <%= form.collection_select(
      :part_id,
      Part.order(:number),
      :id,
      :number,
      prompt: "Select a part"
    ) %>
  </div>

  <div>
    <%= form.label :quantity %>
    <%= form.number_field :quantity, min: 1 %>
  </div>

  <div>
    <%= form.label :due_on %>
    <%= form.date_field :due_on %>
  </div>

  <div>
    <%= form.label :status %>
    <%= form.select(
      :status,
      WorkOrder.statuses.keys.map { |status| [status.humanize, status] }
    ) %>
  </div>

  <div>
    <%= form.label :notes %>
    <%= form.text_area :notes %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
