<% content_for :title, "#{@work_order.number} | Shop Floor" %>

<div class="breadcrumb">
  <%= link_to "Work Orders", work_orders_path %>
  <span>/</span>
  <span><%= @work_order.number %></span>
</div>

<header class="page-heading page-heading--detail">
  <div>
    <p class="eyebrow">Production order</p>
    <h1><%= @work_order.number %></h1>
    <div class="heading-status">
      <span class="status-badge status-badge--<%= @work_order.overdue? ? "overdue" : @work_order.status.dasherize %>">
        <%= @work_order.overdue? ? "Overdue" : @work_order.status.humanize %>
      </span>
      <span>Due <%= @work_order.due_on.to_fs(:long) %></span>
    </div>
  </div>

  <% if authenticated? %>
    <div class="action-group">
      <%= link_to "Edit", edit_work_order_path(@work_order), class: "button button--primary" %>
      <%= button_to "Delete",
        @work_order,
        class: "button button--danger",
        data: { turbo_confirm: "Are you sure?" },
        form: { class: "inline-form" },
        method: :delete %>
    </div>
  <% end %>
</header>

<section class="order-overview">
  <dl class="spec-grid spec-grid--order">
    <div>
      <dt>Part</dt>
      <dd>
        <%= link_to @work_order.part.number, @work_order.part %>
        <small><%= @work_order.part.name %></small>
      </dd>
    </div>
    <div class="spec-grid__feature">
      <dt>Quantity</dt>
      <dd><%= @work_order.quantity %><small> units</small></dd>
    </div>
    <div>
      <dt>Due date</dt>
      <dd><time datetime="<%= @work_order.due_on.iso8601 %>"><%= @work_order.due_on.to_fs(:long) %></time></dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd><%= @work_order.status.humanize %></dd>
    </div>
  </dl>

  <div class="order-notes">
    <span class="order-notes__label">Mission notes</span>
    <p><%= @work_order.notes.presence || "No production notes recorded." %></p>
  </div>
</section>

<section class="section-block operations-block">
  <header class="section-heading">
    <div>
      <p class="eyebrow">Routing sequence / <%= @work_order.operations.size.to_s.rjust(2, "0") %></p>
      <h2>Operations</h2>
    </div>

    <% if authenticated? %>
      <%= link_to "Add operation",
        new_work_order_operation_path(@work_order),
        class: "button button--secondary" %>
    <% end %>
  </header>

  <% if @work_order.operations.any? %>
    <ol class="operation-list">
      <% @work_order.operations.each do |operation| %>
        <li class="operation-item operation-item--<%= operation.status.dasherize %>">
          <span class="operation-item__position"><%= operation.position.to_s.rjust(2, "0") %></span>
          <div class="operation-item__body">
            <strong><%= operation.name %></strong>
            <% if operation.completed_at.present? %>
              <span>Completed <%= operation.completed_at.to_fs(:short) %></span>
            <% else %>
              <span>Sequence pending completion</span>
            <% end %>
          </div>
          <span class="status-badge status-badge--<%= operation.status.dasherize %>"><%= operation.status.humanize %></span>

          <% if authenticated? %>
            <div class="operation-item__actions">
              <%= link_to "Edit",
                edit_work_order_operation_path(@work_order, operation),
                class: "text-link" %>
              <%= button_to "Delete",
                work_order_operation_path(@work_order, operation),
                class: "button-link button-link--danger",
                data: { turbo_confirm: "Are you sure?" },
                form: { class: "inline-form" },
                method: :delete %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <div class="empty-state">
      <span class="empty-state__code">ROUTING / 000</span>
      <p>No operations yet.</p>
    </div>
  <% end %>
</section>

<div class="page-footer-actions">
  <%= link_to "Back to work orders", work_orders_path, class: "text-link text-link--back" %>
</div>
