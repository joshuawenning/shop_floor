<h1><%= @part.number %></h1>

<dl>
  <dt>Name</dt>
  <dd><%= @part.name %></dd>

  <dt>Revision</dt>
  <dd><%= @part.revision.presence || "&mdash;" %></dd>

  <dt>Inventory</dt>
  <dd><%= @part.inventory_quantity %></dd>
</dl>

<p>
  <%= link_to "Edit", edit_part_path(@part) %>
</p>

<p>
  <%= link_to "Back to parts", parts_path %>
</p>

<%= button_to "Delete",
  @part,
  method: :delete,
  data: { turbo_confirm: "Are you sure?" } %>
