<h1><%= @part.number %></h1>

<dl>
  <dt>Name</dt>
  <dd><%= @part.name %></dd>

  <dt>Revision</dt>
  <dd><%= @part.revision.presence || "&mdash;" %></dd>

  <dt>Inventory</dt>
  <dd><%= @part.inventory_quantity %></dd>
</dl>

<% if authenticated? %>
  <p>
    <%= link_to "Edit", edit_part_path(@part) %>
  </p>
<% end %>

<p>
  <%= link_to "Back to parts", parts_path %>
</p>

<% if authenticated? %>
  <%= button_to "Delete",
    @part,
    method: :delete,
    data: { turbo_confirm: "Are you sure?" } %>
<% end %>
