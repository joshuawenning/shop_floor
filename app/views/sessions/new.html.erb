<% content_for :title, "Operator Sign In | Shop Floor" %>

<section class="auth-shell">
  <div class="auth-shell__signal" aria-hidden="true">
    <span>AUTH</span>
    <strong>01</strong>
  </div>

  <div class="auth-panel">
    <header class="auth-panel__heading">
      <p class="eyebrow">Restricted controls</p>
      <h1>Operator Sign In</h1>
      <p>Authenticate to create, modify, or release production records.</p>
    </header>

    <%= form_with url: session_path, class: "record-form record-form--auth" do |form| %>
      <div class="form-field form-field--wide">
        <%= form.label :email_address, "Email address" %>
        <%= form.email_field :email_address,
          autocomplete: "username",
          autofocus: true,
          placeholder: "operator@facility.com",
          required: true,
          value: params[:email_address] %>
      </div>

      <div class="form-field form-field--wide">
        <%= form.label :password %>
        <%= form.password_field :password,
          autocomplete: "current-password",
          maxlength: 72,
          placeholder: "Enter password",
          required: true %>
      </div>

      <div class="form-actions form-actions--stacked">
        <%= form.submit "Sign In", class: "button button--primary button--full" %>
        <%= link_to "Forgot password?", new_password_path, class: "text-link" %>
      </div>
    <% end %>
  </div>
</section>
